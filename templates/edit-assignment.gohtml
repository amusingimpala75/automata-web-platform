<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Automata Web Platform</title>
    <link rel="stylesheet" href="/static/style.css">
  </head>
  <body class="page page-assignment-edit">
    <h1>
      {{if .new}}Create an assignment{{else}}Editing {{ .assignment.name }}{{end}}
    </h1>

    <form class="card-form stack-form" action="/assignment/{{if .new}}-1{{else}}{{.assignment.id}}{{end}}" method="POST">
      <label>Name</label>
      <input type="text" name="name" value="{{if not .new}}{{.assignment.name}}{{end}}" />
      <label>Start</label>
      <input type="datetime-local" name="start" value="{{if not .new}}{{.assignment.start}}{{end}}" />
      <label>End</label>
      <input type="datetime-local" name="end" value="{{if not .new}}{{.assignment.end}}{{end}}" />
      <input class="button" type="submit" value="Update">
    </form>
  </body>
</html>
